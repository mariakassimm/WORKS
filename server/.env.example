# Use `development` locally. In production this MUST be `production` (secure
# cookies, no stack traces). The server refuses to start in production if
# MONGO_URI, JWT_SECRET or CLIENT_URL is missing.
NODE_ENV=production
PORT=5000
# Comma-separated list of allowed browser origins (CORS) — the exact public
# URL(s) of the frontend, no trailing slash. Remove the localhost entry in production.
CLIENT_URL=https://your-works-site.vercel.app,http://localhost:5173

MONGO_URI=

# Long random string (32+ chars), e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=
COOKIE_NAME=works_admin_token

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=works

# ---------- EMAIL (inquiry form) ----------
# Uses the Resend API to send inquiry emails. RESEND_API_KEY is
# backend-only — it must never be exposed to the frontend or committed.
# EMAIL_FROM must be an address on a domain verified in your Resend
# account (see https://resend.com/domains); until that's configured, the
# inquiry form will fail safely with a generic error rather than send.
RESEND_API_KEY=
# Sender, e.g. inquiries@your-domain.com (domain must be verified in Resend).
# For quick local tests only, Resend allows onboarding@resend.dev, but it can
# deliver ONLY to the email address that owns the Resend account.
EMAIL_FROM=

# Where inquiries are delivered. Server-side only — the browser never supplies
# a recipient. The customer's address is used only as the Reply-To.
BUSINESS_EMAIL=hello@example.com
