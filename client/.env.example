# Frontend variables are baked into the public JavaScript bundle at BUILD time.
# Never put secrets here. Set these in the hosting platform (e.g. Vercel) and rebuild.
# VITE_API_URL is REQUIRED for production builds (no localhost fallback).
# Production example: VITE_API_URL=https://your-api-host/api
VITE_API_URL=http://localhost:5000/api
# Public origin of the deployed site (no trailing slash). Used at build time for
# absolute og:image URLs, sitemap.xml and robots.txt. Required for good SEO/sharing.
# VITE_SITE_URL=https://www.example.com

# Contact details shown on the site. Uncomment and set to override. The built-in defaults are FICTIONAL
# demonstration values (hello@example.com, +1 (202) 555-0147, 100 Example Avenue…);
# set real values here before launch. "Get Directions" only appears once
# VITE_BUSINESS_ADDRESS is set.
# VITE_BUSINESS_EMAIL=hello@example.com
# VITE_BUSINESS_PHONE=+1 (202) 555-0147
# VITE_BUSINESS_ADDRESS=100 Example Avenue, Sample City, ZZ 00000
# VITE_BUSINESS_HOURS=Mon – Sat, 9:00 AM – 6:00 PM

# Digits only, with country code. Leave empty to hide all WhatsApp buttons.
VITE_WHATSAPP_NUMBER=

# Price prefix shown in the catalogue (e.g. $, €, £, Rs ).
# VITE_CURRENCY_SYMBOL=$

# Social profiles — full https:// URLs. Empty = shown as a disabled placeholder
# on the About page and omitted from the footer.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_X=
VITE_SOCIAL_LINKEDIN=
